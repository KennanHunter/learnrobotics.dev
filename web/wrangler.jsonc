{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learnrobotics-preview",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/ssr.tsx",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    // this is only for development
    {
      "binding": "DB",
      "database_name": "learnrobotics",
      "database_id": "1bf952ff-b171-4482-ad37-56be7c4d5362",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    { "binding": "R2", "bucket_name": "learn-robotics-dev-storage" }
  ],
  "vars": {
    "DEPLOYMENT_URL": "https://preview.learnrobotics.dev",
    "ENVIRONMENT": "preview",
    "ADMIN_GITHUB_USER_ID": "",
    "R2_ACCOUNT_ID": "1de9d7646d10b16be16d4afc4ac9a19b"
  },
  "env": {
    "production": {
      "name": "learnrobotics",
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "learnrobotics",
          "database_id": "07f8d523-1113-4147-9e26-ca40e96e9c88",
          "migrations_dir": "./drizzle"
        }
      ],
      "r2_buckets": [
        { "binding": "R2", "bucket_name": "learn-robotics-dev-storage" }
      ],
      "vars": {
        "DEPLOYMENT_URL": "https://learnrobotics.dev",
        "ENVIRONMENT": "alpha",
        "ADMIN_GITHUB_USER_ID": "",
        "R2_ACCOUNT_ID": "1de9d7646d10b16be16d4afc4ac9a19b"
      }
    }
  }
}
