{
  "name": "learnrobotics-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev 2>&1 | sed -u 's/^stdout: //; s/^stderr: //' | pino-pretty --colorize --translateTime 'SYS:HH:MM:ss.l' --ignore pid,hostname,env --messageFormat '{scope} · {msg}'",
    "dev:plain": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pipeline": "vitest run --config vitest.pipeline.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:production": "pnpm run build && wrangler deploy --env production",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply learnrobotics --local",
    "db:migrate:remote": "wrangler d1 migrations apply learnrobotics --remote",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy:storybook": "pnpm run build-storybook && wrangler deploy --config wrangler.storybook.jsonc"
  },
  "dependencies": {
    "@bytecodealliance/preview2-shim": "^0.31.1",
    "@inlang/paraglide-js": "^3.2.2",
    "@learnrobotics/bundling": "workspace:*",
    "@learnrobotics/content": "workspace:*",
    "@learnrobotics/db": "workspace:*",
    "@learnrobotics/editor": "workspace:*",
    "@learnrobotics/events": "workspace:*",
    "@learnrobotics/runtime": "workspace:*",
    "@learnrobotics/teavm-compiler": "workspace:*",
    "@mdx-js/rollup": "^3.1.1",
    "@monaco-editor/loader": "^1.7.0",
    "@tanstack/solid-router": "1.170.39",
    "@tanstack/solid-start": "~1.168.0",
    "@tanstack/solid-virtual": "^3.13.53",
    "@thisbeyond/solid-dnd": "^0.7.5",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.23",
    "drizzle-orm": "^0.45.4",
    "monaco-editor": "^0.57.0",
    "pino": "^10.4.0",
    "prismjs": "^1.30.0",
    "solid-icons": "catalog:",
    "solid-js": "^1.9.19",
    "solid-resizable-panels": "^0.5.4",
    "turndown": "^7.2.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@cloudflare/vite-plugin": "^1.69.1",
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@playwright/test": "^1.65.1",
    "@solidjs/meta": "^0.29.8",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/solid-router-devtools": "~1.167.0",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@types/turndown": "^5.0.5",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "playwright": "latest",
    "storybook": "^10.6.7",
    "storybook-solidjs-vite": "latest",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^4.1.12",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.162.0"
  }
}
