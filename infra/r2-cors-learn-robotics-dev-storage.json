{
  "rules": [
    {
      "id": "web-clients",
      "allowed": {
        "methods": ["GET", "HEAD"],
        "origins": [
          "https://learnrobotics.dev",
          "https://www.learnrobotics.dev",
          "https://preview.learnrobotics.dev",
          "http://localhost:5173"
        ],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Type"],
      "maxAgeSeconds": 3600
    }
  ]
}
